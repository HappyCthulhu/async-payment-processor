set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Show available project commands.
default:
    @just --list

# Initialize Alembic once. Afterward configure alembic/env.py to use BaseModel.metadata.
init-alembic:
    uv run alembic init alembic

# Create an autogenerated Alembic revision from SQLAlchemy models.
revision message:
    uv run alembic revision --autogenerate -m "{{message}}"

# Apply all pending migrations.
upgrade:
    uv run alembic upgrade head

# Revert migrations; default is one revision back.
downgrade revision="-1":
    uv run alembic downgrade "{{revision}}"

# Show the revision currently applied to the database.
current:
    uv run alembic current

# Show the migration graph.
history:
    uv run alembic history --verbose

# Start PostgreSQL for local development and migrations.
db-up:
    docker compose up -d postgres

# Stop local PostgreSQL without deleting its data volume.
db-down:
    docker compose down

# Follow PostgreSQL logs.
db-logs:
    docker compose logs --follow postgres

# Open psql inside the local PostgreSQL container.
db-shell:
    docker compose exec postgres psql -U "${POSTGRES_USER:-payment_user}" -d "${POSTGRES_DB:-payment_processor}"

# Run the FastAPI application locally with reload enabled.
api:
    uv run uvicorn payment_processor.api.app:app --reload

# Run the automated test suite against an isolated PostgreSQL schema.
test:
    APP_DB_ECHO=false uv run pytest
