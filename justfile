set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set dotenv-load := true

# Show available project commands.
default:
    @just --list

# Build and start the complete demo stack (including migrations).
up:
    docker compose up -d --build

# Stop the demo stack, preserving database and broker volumes.
down:
    docker compose down

# Follow the demo stack logs.
logs:
    docker compose logs -f

# Initialize Alembic once. Afterward configure alembic/env.py to use BaseModel.metadata.
init-alembic:
    uv run alembic init alembic

# Create an autogenerated Alembic revision from SQLAlchemy models.
revision message:
    uv run alembic revision --autogenerate -m "{{message}}"

# Apply all pending migrations.
upgrade:
    uv run alembic upgrade head

# Revert migrations; default is one revision back.
downgrade revision="-1":
    uv run alembic downgrade "{{revision}}"

# Show the revision currently applied to the database.
current:
    uv run alembic current

# Show the migration graph.
history:
    uv run alembic history --verbose

# Start PostgreSQL and RabbitMQ for local development.
db-up:
    docker compose up -d --wait postgres rabbitmq

# Stop local infrastructure without deleting data volumes.
db-down:
    docker compose down

# Follow PostgreSQL logs.
db-logs:
    docker compose logs --follow postgres

# Open psql inside the local PostgreSQL container.
db-shell:
    docker compose exec postgres psql -U "${POSTGRES_USER:-payment_user}" -d "${POSTGRES_DB:-payment_processor}"

# Start RabbitMQ and wait until AMQP and Management UI are ready.
rabbit-up:
    docker compose up -d --wait rabbitmq

# Follow RabbitMQ logs.
rabbit-logs:
    docker compose logs --follow rabbitmq

# Open RabbitMQ Management UI in a browser: http://localhost:15672.
rabbit-ui:
    @echo "RabbitMQ Management UI: http://localhost:${RABBITMQ_MANAGEMENT_PORT:-15672}"
    @echo "Credentials: ${RABBITMQ_DEFAULT_USER:-payment_broker} / (see .env for password)"

# Start all infrastructure required by the current integration-test suite.
infra-up: db-up

# Run the FastAPI application locally with reload enabled.
api:
    uv run uvicorn payment_processor.api.app:app --reload

# Run the FastStream worker that consumes payment events from RabbitMQ.
worker:
    just db-up
    uv run faststream run payment_processor.worker.app:app

# Run tests with isolated PostgreSQL schemas and a separate RabbitMQ broker.
test:
    docker compose up -d --wait postgres rabbitmq-test
    APP_DB_ECHO=false APP_RABBITMQ_URL="amqp://test_broker:test_broker_password@localhost:${TEST_RABBITMQ_PORT:-5673}/" APP_RABBITMQ_MANAGEMENT_URL="http://localhost:${TEST_RABBITMQ_MANAGEMENT_PORT:-15673}" uv run pytest
