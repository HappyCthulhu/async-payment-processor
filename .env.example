# Application settings for commands run from the host machine.
APP_DATABASE_URL=postgresql+asyncpg://payment_user:payment_password@localhost:5433/payment_processor
APP_API_KEY=local-development-key
APP_DB_ECHO=true
APP_RABBITMQ_URL=amqp://payment_broker:payment_broker_password@localhost:5672/
APP_RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# PostgreSQL container settings.
POSTGRES_DB=payment_processor
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_password
POSTGRES_PORT=5433

# RabbitMQ container settings.
RABBITMQ_DEFAULT_USER=payment_broker
RABBITMQ_DEFAULT_PASS=payment_broker_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
